# Copy to .env and fill in to upgrade from simulation -> real services.
# Everything runs WITHOUT these keys (deterministic planner + simulated payments).

# --- LLM (optional). If unset, a deterministic intent parser is used. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Razorpay test mode (optional). If unset, payments are simulated end-to-end. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Receipt signing. A random key is generated per-run if unset. Set for stable verification. ---
AUXION_SIGNING_KEY=

# --- Public base URL for webhooks (e.g. ngrok). Defaults to local. ---
AUXION_PUBLIC_URL=http://localhost:8000
