# Copy to .env and fill in to upgrade from simulation -> real services.
# Everything runs WITHOUT these keys (deterministic planner + simulated payments).

# --- LLM provider fallback chain (optional) ---
# Tried in this order; the first healthy provider serves the request, and a
# failure (bad key, timeout, rate-limit, 5xx) automatically drops to the next
# layer. If every layer fails the deterministic intent parser takes over and
# the failure reason is surfaced in the response + /api/llm/status.
# Leave OLLAMA_ENABLED=0 if you don't run a local Ollama.
GROQ_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
NEMOTRON_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=1

# Model overrides (defaults verified per provider; only set if you want a
# different model, e.g. OPENROUTER_MODEL=anthropic/claude-3.5-sonnet):
# GROQ_MODEL=            (default: openai/gpt-oss-120b)
# SAMBANOVA_MODEL=       (default: Meta-Llama-3.1-70B-Instruct)
# MISTRAL_MODEL=         (default: mistral-small-latest)
# CEREBRAS_MODEL=        (default: gpt-oss-120b)
# NVIDIA_MODEL=          (default: nvidia/llama-3.1-nemotron-70b-instruct)
# NEMOTRON_MODEL=        (default: nvidia/llama-3.1-nemotron-ultra-253b-v1)
# OPENROUTER_MODEL=      (default: meta-llama/llama-3.3-70b-instruct)
# OLLAMA_MODEL=          (default: llama3.1:70b)

# --- Razorpay test mode (optional). If unset, payments are simulated end-to-end. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Signing keys. Random per-run if unset; set for stable receipt/JWT verification. ---
AUXION_SIGNING_KEY=
AUXION_JWT_KEY=

# --- Public base URL for webhooks (e.g. ngrok). Defaults to local. ---
AUXION_PUBLIC_URL=http://localhost:8000

# --- Optional admin auth. If set, /api/* (except /api/token, /api/llm/status) ---
# --- require the X-Auxion-Token header. Leave empty to keep the demo open.   ---
AUXION_ADMIN_TOKEN=

# --- Which store to run at startup (config/catalog.json -> merchants). ---
AUXION_MERCHANT=auxion-demo-store
